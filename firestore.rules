rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Reference data: read-only for signed-in users, never writable from the app.
    match /snapshotTypes/{typeId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Baseline until R8: only signed-in users, only their own documents.
    match /snapshots/{snapshotId} {
      allow read, update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    // Everything else is denied by default.
  }
}
